# Baseline for the OneBeat engine. Kept deliberately small in Stage 1: every check
# here must be green, so that a violation is a real signal rather than noise.
#
# Two checks are switched off deliberately (comments cannot live inside the
# block scalar below, so the reasoning is here):
#
#   performance-enum-size — the enum widths it objects to are layout decisions,
#     not oversights. RtMessage sits in a frozen 32-byte log record and
#     EventType in a frozen 24-byte schedule event; both are pinned by tests.
#
#   misc-const-correctness — it flags every RAII lock guard as "can be const".
#     Nobody writes `const std::lock_guard`, and the check has no way to exclude
#     a type, so the noise buries the occasional real finding.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  cppcoreguidelines-pro-type-cstyle-cast,
  cppcoreguidelines-slicing,
  misc-*,
  -misc-const-correctness,
  -misc-non-private-member-variables-in-classes,
  -misc-include-cleaner,
  -misc-use-anonymous-namespace,
  modernize-use-override,
  modernize-use-nullptr,
  modernize-use-using,
  performance-*,
  -performance-enum-size,
  readability-identifier-naming

WarningsAsErrors: '*'
# The public ABI header is C, not C++: it is checked by the standalone
# `clang -x c` syntax job (OB-1-04) rather than by C++ tidy checks.
HeaderFilterRegex: 'engine/src/(core|audio_io|testing)/.*'

CheckOptions:
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: camelBack
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: _
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase
  - key: readability-identifier-naming.ConstexprVariableCase
    value: CamelCase
  - key: readability-identifier-naming.GlobalConstantCase
    value: CamelCase
